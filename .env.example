# Application Settings
APP_NAME="RFQ British Auction API"
API_PREFIX="/api/v1"

# Database & Redis Settings (Host defaults when running outside Docker)
DATABASE_URL=postgresql+asyncpg://bidding:bidding@localhost:5434/bidding
REDIS_URL=redis://localhost:6380/0
SQL_ECHO=false

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Background Worker Settings
ENABLE_CLOSER=true
CLOSER_INTERVAL_SECONDS=2.0

# SSE Settings
SSE_HEARTBEAT_SECONDS=15.0

